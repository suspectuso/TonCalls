# Copy to .env and fill in real values.
# .env is in .gitignore — secrets never leave the working copy.

# =============================================================================
# Required — Telegram credentials
# =============================================================================

# Userbot (Telethon MTProto)
# Get on https://my.telegram.org → API development tools.
API_ID=12345678
API_HASH=replace_with_real_hash

# Bot API bot (for enriched posts with an inline button).
# Get one from @BotFather.
BOT_TOKEN=replace_with_bot_token

# Session file for the userbot. `<SESSION_NAME>.session` sits next to main.py.
# First run will prompt for the phone number + code.
SESSION_NAME=session

# Optional Telegram user_id where the bot DMs its own logs.
LOG_CHAT_ID=0

# =============================================================================
# Publishing channels
# =============================================================================

# Legacy plain-forward target. Leave empty if you only want enriched posts.
TARGET_CHANNEL=

# Primary enriched-post target (Bot API path — with an inline button).
# The bot must be an admin here.
ENRICHED_TARGET_CHANNEL=
ENRICHED_ENABLED=1

# Optional secondary target (userbot path — no button, comment threads work,
# footer text links instead). The userbot account must have permission to post here.
ENRICHED_DUP_CHANNEL=

# =============================================================================
# Public references (DTrade / Redotrade TON trading bots)
# =============================================================================

# Referral start-parameter prefixes. Sign up in the respective bot to get yours.
DTRADE_DEEPLINK_PREFIX=ref_
REDO_DEEPLINK_PREFIX=ref_

# =============================================================================
# Preview server (chart-proxy/)
# =============================================================================

# Public https domain your chart-proxy is served from (no trailing slash).
# Example: chart.example.com
CHART_PROXY_DOMAIN=

# Small brand label drawn in the corner of the composite (empty = no label).
# Example: by @your_channel
BRAND_MARK=

# =============================================================================
# Caption template + optional AI hot-take
# =============================================================================

# Header line of each enriched post. `{handle}` is substituted with @username
# (or the channel title when it is not a valid handle).
CAPTION_HEADER_TEMPLATE={handle} posted:

# Path to a plain-text prompt file for the local LLM (optional).
# If unset or missing, a minimal default English prompt is used.
# See prompts/hot_take.example.txt.
AI_PROMPT_FILE=

# =============================================================================
# Source channels file
# =============================================================================

# Path to the newline-separated list of source @handles.
CHANNELS_FILE=channels.txt
